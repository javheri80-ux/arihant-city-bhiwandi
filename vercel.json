{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "redirects": [
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "arihantcity.site"
        }
      ],
      "destination": "https://www.arihantcity.site/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin.php"
    },
    {
      "source": "/contact",
      "destination": "/api/contact.php"
    },
    {
      "source": "/leads",
      "destination": "/api/baba-leads.php"
    },
    {
      "source": "/price",
      "destination": "/arihant-city-price.html"
    },
    {
      "source": "/arihant-city-price",
      "destination": "/arihant-city-price.html"
    },
    {
      "source": "/floor-plans",
      "destination": "/arihant-city-floor-plans.html"
    },
    {
      "source": "/arihant-city-floor-plans",
      "destination": "/arihant-city-floor-plans.html"
    },
    {
      "source": "/location",
      "destination": "/arihant-city-location.html"
    },
    {
      "source": "/arihant-city-location",
      "destination": "/arihant-city-location.html"
    },
    {
      "source": "/amenities",
      "destination": "/arihant-city-amenities.html"
