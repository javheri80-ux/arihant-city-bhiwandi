      "source": "/arihant-city-configurations",
      "destination": "/arihant-city-configurations.html"
    },
    {
      "source": "/maharera",
      "destination": "/arihant-city-maharera.html"
    },
    {
      "source": "/arihant-city-maharera",
      "destination": "/arihant-city-maharera.html"
    },
    {
      "source": "/developer",
      "destination": "/arihant-city-developer.html"
    },
    {
      "source": "/arihant-city-developer",
      "destination": "/arihant-city-developer.html"
    },
    {
